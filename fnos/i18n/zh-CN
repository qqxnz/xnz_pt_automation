[manifest]
desc="面向 NAS 的 PT 自动化系统：按规则抓取 PT 站点种子、推送到 qBittorrent 下载器、检查免费时间并按规则删除，统计各站点上传/下载/分享率。<br/>内置 Vue 前端与 Express API，开箱即用。<br/><a target=\"_blank\" href=\"https://github.com/qqxnz/xnz_pt_automation\">项目主页</a>"

[install]
step_port_title="端口设置"
label_service_port="Web 端口"
service_port_required="请输入端口"
service_port_pattern="端口必须为 2-5 位数字"

[uninstall]
step_data_title="数据说明"
data_keep_tip="卸载应用不会清空共享目录 <code>pta/data</code> 下的数据，卸载后共享目录及其中的数据将保留。您可以在「文件管理 → 共享文件夹」中查看和管理。"

[upgrade]
step_version_title="升级版本"
version_tip="面向 NAS 的 PT 自动化系统：按规则抓取 PT 站点种子、推送到 qBittorrent 下载器、检查免费时间并按规则删除，统计各站点上传/下载/分享率。<br/>内置 Vue 前端与 Express API，开箱即用。<br/><a target=\"_blank\" href=\"https://github.com/qqxnz/xnz_pt_automation\">项目主页</a>"