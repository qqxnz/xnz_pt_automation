#!/bin/bash
# 升级前钩子：将 0.6.23 及更早版本的数据从 $TRIM_PKGVAR/data 迁移到共享目录
# 0.6.24 起数据目录映射改为 fnOS data-share (TRIM_DATA_SHARE_PATHS)
# 迁移策略：
#   - 仅检测一次：若共享目录中已存在 app.db，认为用户已升级过新版本，跳过迁移
#   - 若共享目录为空但 TRIM_PKGVAR/data 存在数据，则复制过去
#   - 复制成功后在共享目录创建 .migrated 标记，避免重复处理
#   - 复制失败时输出错误并继续（不阻塞升级），老数据保留在 TRIM_PKGVAR/data 兜底
#
# 注意：用户可见的 echo 字符串避免使用全角逗号/冒号等中文标点，
#       旧版 bash (3.2) 在 set -u 下对含全角标点的双引号字符串 + 变量替换存在 bug，
#       会误报变量未绑定。这里统一使用 ASCII 逗号 + 空格。

set -u

LEGACY_DIR="${TRIM_PKGVAR}/data"
SHARE_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
MIGRATION_MARK=".migrated-from-legacy"

# 取第一个 share 路径；TRIM_DATA_SHARE_PATHS 多路径以 : 分隔
if [ -z "$SHARE_DIR" ]; then
  echo "⚠️  TRIM_DATA_SHARE_PATHS 为空, 跳过数据迁移" >> "$TRIM_TEMP_LOGFILE"
  exit 0
fi

# 已迁移过则跳过
if [ -f "$SHARE_DIR/$MIGRATION_MARK" ]; then
  exit 0
fi

# 老目录无数据则无需迁移, 直接写标记
if [ ! -d "$LEGACY_DIR" ] || [ -z "$(ls -A "$LEGACY_DIR" 2>/dev/null)" ]; then
  mkdir -p "$SHARE_DIR" 2>/dev/null || true
  touch "$SHARE_DIR/$MIGRATION_MARK" 2>/dev/null || true
  exit 0
fi

# 共享目录已有数据(可能是用户自己放进去的), 不强行覆盖
if [ -n "$(ls -A "$SHARE_DIR" 2>/dev/null)" ]; then
  echo "ℹ️  共享目录 $SHARE_DIR 已有内容, 跳过自动迁移 (请手动处理老数据)" >> "$TRIM_TEMP_LOGFILE"
  exit 0
fi

mkdir -p "$SHARE_DIR" 2>/dev/null || {
  echo "❌ 无法创建共享目录 $SHARE_DIR" >> "$TRIM_TEMP_LOGFILE"
  exit 0
}

echo "🔄 正在将历史数据从 $LEGACY_DIR 迁移到共享目录 $SHARE_DIR ..." >> "$TRIM_TEMP_LOGFILE"

if cp -a "$LEGACY_DIR"/. "$SHARE_DIR"/ 2>>"$TRIM_TEMP_LOGFILE"; then
  touch "$SHARE_DIR/$MIGRATION_MARK" 2>/dev/null || true
  echo "✅ 历史数据已迁移至共享目录 $SHARE_DIR" >> "$TRIM_TEMP_LOGFILE"
  echo "   原数据保留在 $LEGACY_DIR, 确认新版本运行正常后可手动清理" >> "$TRIM_TEMP_LOGFILE"
else
  echo "❌ 数据迁移失败, 请检查共享目录权限" >> "$TRIM_TEMP_LOGFILE"
fi

exit 0