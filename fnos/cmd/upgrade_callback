#!/bin/bash
# 升级后钩子：提示用户升级结果
VERSION="$(awk -F '=' '/^version[[:space:]]*=/{ gsub(/[[:space:]]/, "", $2); print $2; exit }' "${TRIM_APPDEST}/manifest" 2>/dev/null)"
{
  if [ -n "$VERSION" ]; then
    echo "✅ xnz-pt-automation 已升级到 ${VERSION}"
  else
    echo "✅ xnz-pt-automation 已升级到当前 fpk 内置版本"
  fi
  echo "   容器会自动重启，等待约 30 秒后即可访问"
} >> "$TRIM_TEMP_LOGFILE"
exit 0
